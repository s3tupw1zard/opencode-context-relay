# Container image tag. Use "dev" or an exact development version only when intentionally testing a development release.
CONTEXT_RELAY_VERSION=latest

# Copy to .env or run ./scripts/generate-env.sh.
POSTGRES_DB=context_bridge
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=REPLACE_ME
CONTEXT_BRIDGE_WRITER_PASSWORD=REPLACE_ME
CONTEXT_BRIDGE_READER_PASSWORD=REPLACE_ME

# Public HTTPS MCP endpoint.
MCP_PUBLIC_URL=https://context.example.com/mcp
MCP_PORT=8787

# OAuth 2.1 authorization server used by ChatGPT.
MCP_AUTH_MODE=oauth
OAUTH_ISSUER=https://auth.example.com
OAUTH_ALLOWED_SUBJECT=REPLACE_ME
OAUTH_ALLOW_SHARED_BACKEND=false

# The reverse proxy terminates OpenAI-managed mTLS and overwrites the
# X-OpenAI-MTLS-* headers before proxying to the bridge.
MCP_TRUST_PROXY_MTLS=true
MCP_EXPECTED_OPENAI_SAN=mtls.prod.connectors.openai.com

STORAGE_TIMEOUT_MS=5000
STALE_AFTER_MS=900000
STORAGE_MAX_ROWS=1000
