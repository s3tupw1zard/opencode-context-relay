{
  "name": "opencode-context-relay",
  "version": "2026.1.0-dev.9",
  "description": "WIP OpenCode v2 context relay for safe structured PostgreSQL state consumed by ChatGPT.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "import": "./dist/rpc.js",
      "default": "./dist/rpc.js"
    }
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s3tupw1zard/opencode-context-relay.git",
    "directory": "packages/opencode-context-relay"
  },
  "homepage": "https://github.com/s3tupw1zard/opencode-context-relay#readme",
  "bugs": {
    "url": "https://github.com/s3tupw1zard/opencode-context-relay/issues"
  },
  "keywords": [
    "opencode",
    "plugin",
    "chatgpt",
    "mcp",
    "postgresql",
    "context",
    "relay"
  ],
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke:package": "node scripts/smoke-package.mjs",
    "check": "bun run typecheck && bun test && npm run build && npm run smoke:package",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "@types/pg": "^8.15.5"
  },
  "engines": {
    "node": ">=22",
    "opencode": ">=2.0.4"
  },
  "types": "./dist/index.d.ts"
}
