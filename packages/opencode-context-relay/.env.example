# Direct PostgreSQL connection used by the OpenCode publisher.
# Use a dedicated context_bridge_writer login, never an administrator account.
BRIDGE_DATABASE_URL=postgresql://context_bridge_writer:REPLACE_ME@127.0.0.1:5432/context_bridge

# Schema containing the context model tables.
BRIDGE_DATABASE_SCHEMA=context_bridge

# Persist append-only sanitized semantic snapshots, decisions, diagnostics and
# validation summaries.
BRIDGE_HISTORY_ENABLED=true

# Persist safe tool/session activity metadata. Raw tool arguments/results are
# never stored. Disable independently if the extra event volume is unwanted.
BRIDGE_ACTIVITY_HISTORY_ENABLED=true

# Optional logical label shown to ChatGPT. Defaults to the git repository name.
BRIDGE_PROJECT_LABEL=

# Structured plugin diagnostics. Default is info.
# error | warn | info | debug
BRIDGE_LOG_LEVEL=info

# Optional. Defaults to $XDG_STATE_HOME/opencode-context-bridge/opencode-context-bridge.log
# or ~/.local/state/opencode-context-bridge/opencode-context-bridge.log.
# BRIDGE_LOG_FILE=/var/log/opencode-context-bridge/opencode-context-bridge.log
