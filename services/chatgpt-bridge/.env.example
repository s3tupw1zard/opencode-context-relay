# Dedicated read-only PostgreSQL role. Do not use postgres/service_role.
DATABASE_URL=postgresql://context_bridge_reader:REPLACE_ME@127.0.0.1:5432/context_bridge
DATABASE_SCHEMA=context_bridge

MCP_HOST=127.0.0.1
MCP_PORT=8787
MCP_PUBLIC_URL=https://context.example.com/mcp

MCP_AUTH_MODE=oauth
OAUTH_ISSUER=https://auth.example.com
# Optional when issuer discovery does not provide the desired JWKS endpoint.
# OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
OAUTH_ALLOWED_SUBJECT=REPLACE_ME
OAUTH_ALLOW_SHARED_BACKEND=false

# Enable only when the service is reachable exclusively through a trusted
# reverse proxy that overwrites X-OpenAI-MTLS-*.
MCP_TRUST_PROXY_MTLS=true
MCP_EXPECTED_OPENAI_SAN=mtls.prod.connectors.openai.com

# Inspector/custom-client testing only:
# MCP_AUTH_MODE=bearer
# MCP_BEARER_TOKEN=GENERATE_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS

STORAGE_TIMEOUT_MS=5000
STALE_AFTER_MS=900000
STORAGE_MAX_ROWS=1000
