# Direct connection to existing self-hosted Supabase Postgres, preferably private network.
# Use context_bridge_reader, NOT postgres/service_role. URL-encode password.
DATABASE_URL=postgresql://context_bridge_reader:REPLACE_ME@postgres.internal:5432/postgres?sslmode=verify-full
MCP_HOST=127.0.0.1
MCP_PORT=8787
# Set your eventual public domain; this is the OAuth resource/audience.
MCP_PUBLIC_URL=https://YOUR_MCP_DOMAIN/mcp
MCP_AUTH_MODE=oauth
OAUTH_ISSUER=https://YOUR_POCKET_ID_DOMAIN
# Optional; if set, must match Pocket ID discovery exactly.
# OAUTH_JWKS_URL=https://YOUR_POCKET_ID_DOMAIN/.well-known/jwks.json
OAUTH_ALLOWED_SUBJECT=YOUR_POCKET_ID_USER_SUBJECT
# Only explicitly enable if every authorized Pocket ID user may read this same backend.
OAUTH_ALLOW_SHARED_BACKEND=false
# Local Inspector/custom-client testing only. Not ChatGPT OAuth linking.
# MCP_AUTH_MODE=bearer
# MCP_BEARER_TOKEN=GENERATE_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
STORAGE_TIMEOUT_MS=5000
STALE_AFTER_MS=900000
STORAGE_MAX_ROWS=1000
