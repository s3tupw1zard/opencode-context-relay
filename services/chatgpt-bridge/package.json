{
  "name": "context-bridge-chatgpt",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "node --env-file=.env dist/src/main.js",
    "dev": "tsx --env-file=.env src/main.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
